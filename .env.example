# ==============================================================================
# AI Chatbot Server Environment Configuration Example
# Copy this file to .env and configure the secrets appropriately for your environment.
# ==============================================================================

# Database connection URL (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/ai_chat_bot

# Port for the API server (defaults to 8080)
PORT=8080

# Environment mode (production, development, test)
NODE_ENV=production

# Strong random secret used for signing express session cookies (at least 32 characters)
# Example generation: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_session_secret_min_32_chars

# 32-byte cryptographic key for AES-256-GCM encryption of sensitive database fields
# (e.g., SMTP passwords, API keys, client tokens). Hex (64 chars) or plain 32 chars.
# Example generation: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_a_secure_hex_32_byte_encryption_key

# Dedicated secret for HMAC-SHA256 signature verification of one-click plan approval links.
# Prevents unauthorized tier upgrades or forgeable links. (Required in production)
# Example generation: openssl rand -base64 32
PLAN_APPROVAL_SECRET=replace_with_a_secure_plan_approval_secret

# Secret required in x-email-webhook-token header for inbound email webhook plan approvals
INBOUND_EMAIL_WEBHOOK_SECRET=replace_with_inbound_email_webhook_secret

# Reverse proxy trust configuration
# Set to '1' or comma-separated list of proxy IPs/CIDRs if behind a reverse proxy (Nginx, Cloudflare, AWS ALB).
# Set to 'false' or omit in standalone VPS/Docker deployments to prevent IP header spoofing.
TRUSTED_PROXIES=false

# When set to true in production, refuses server startup if ENCRYPTION_KEY is missing
REQUIRE_STRICT_SECRETS=false
